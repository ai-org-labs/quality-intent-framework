{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/qif/schemas/world-model-calibration-package.schema.json",
  "title": "QIF World Model Calibration Package",
  "type": "object",
  "required": [
    "packageType",
    "runtimeVersion",
    "packageId",
    "packageRefs",
    "evidenceOrigins",
    "calibrationPolicies",
    "calibrationCases",
    "expertAssessments",
    "agentAssessments",
    "findingMatches",
    "evaluationSuiteHealthRecords",
    "trialVarianceRecords",
    "frameworkLearningRecords",
    "calibrationRuns",
    "governanceTriggers",
    "verifierBoundary"
  ],
  "additionalProperties": false,
  "properties": {
    "packageType": { "const": "world-model-calibration" },
    "runtimeVersion": { "type": "string" },
    "packageId": { "type": "string" },
    "packageRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/packageRef" }
    },
    "evidenceOrigins": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceOrigin" }
    },
    "calibrationPolicies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/calibrationPolicy" }
    },
    "calibrationCases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/calibrationCase" }
    },
    "expertAssessments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/expertAssessment" }
    },
    "agentAssessments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/agentAssessment" }
    },
    "findingMatches": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/findingMatch" }
    },
    "evaluationSuiteHealthRecords": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evaluationSuiteHealthRecord" }
    },
    "trialVarianceRecords": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/trialVarianceRecord" }
    },
    "frameworkLearningRecords": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frameworkLearningRecord" }
    },
    "calibrationRuns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/calibrationRun" }
    },
    "governanceTriggers": {
      "type": "array",
      "items": { "$ref": "#/$defs/governanceTrigger" }
    },
    "verifierBoundary": { "$ref": "#/$defs/verifierBoundary" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+-[A-Z0-9-]+$"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "refArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "minItems": 1
    },
    "packageRef": {
      "type": "object",
      "required": ["id", "path", "packageType", "role"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string" },
        "packageType": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "entityRef": {
      "type": "object",
      "required": ["packageRef", "entityType", "entityRef"],
      "additionalProperties": false,
      "properties": {
        "packageRef": { "$ref": "#/$defs/id" },
        "entityType": { "type": "string" },
        "entityRef": { "$ref": "#/$defs/id" }
      }
    },
    "evidenceOrigin": {
      "type": "object",
      "required": ["id", "originKind", "sourceArtifact", "observationWindow", "environment", "generatedBy", "verifiedBy", "transformationSummary", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "originKind": { "enum": ["observed-operational", "historical-record", "simulated", "synthetic", "example"] },
        "sourceArtifact": { "type": "string", "minLength": 1 },
        "observationWindow": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "generatedBy": { "type": "string", "minLength": 1 },
        "verifiedBy": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "transformationSummary": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "verified", "stale", "retired"] }
      }
    },
    "calibratedFinding": {
      "type": "object",
      "required": ["id", "gapObjectType", "missingItem", "expectedDefinition", "verdictEffect", "severity", "rationale"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "gapObjectType": { "enum": ["Concept", "Actor", "Boundary", "Relationship", "State", "Event", "Invariant", "CoordinateAxis", "CoordinateSystem", "Perspective", "Assumption", "DomainEntity"] },
        "missingItem": { "type": "string" },
        "expectedDefinition": { "type": "string" },
        "verdictEffect": { "enum": ["block-evaluation", "degrade-confidence", "require-governance", "note-residual-risk"] },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "rationale": { "type": "string" },
        "sourceFindingRef": { "$ref": "#/$defs/entityRef" }
      }
    },
    "calibrationPolicy": {
      "type": "object",
      "required": [
        "id",
        "title",
        "targetPackageRefs",
        "minimumCaseCount",
        "requiredDomains",
        "requiredExpertAssessorsPerCase",
        "minimumTrialCount",
        "requiresUnseenCases",
        "agreementThreshold",
        "falsePositiveRateMax",
        "falseNegativeRateMax",
        "scoreRule",
        "governanceOnFailure",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "targetPackageRefs": { "$ref": "#/$defs/refArray" },
        "minimumCaseCount": { "type": "integer", "minimum": 1 },
        "requiredDomains": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "requiredExpertAssessorsPerCase": { "type": "integer", "minimum": 1 },
        "minimumTrialCount": { "type": "integer", "minimum": 2 },
        "requiresUnseenCases": { "type": "boolean" },
        "agreementThreshold": { "$ref": "#/$defs/score" },
        "falsePositiveRateMax": { "$ref": "#/$defs/score" },
        "falseNegativeRateMax": { "$ref": "#/$defs/score" },
        "scoreRule": { "enum": ["exact-1-partial-0.5-miss-0"] },
        "governanceOnFailure": { "type": "boolean" },
        "status": { "enum": ["draft", "active", "retired"] }
      }
    },
    "calibrationCase": {
      "type": "object",
      "required": ["id", "title", "domain", "targetDescription", "sourceArtifact", "evidenceOriginRef", "unseenCase", "sourceWorldModelRef", "expectedGapObjectTypes", "decisionContext"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "domain": { "type": "string" },
        "targetDescription": { "type": "string" },
        "sourceArtifact": { "type": "string" },
        "evidenceOriginRef": { "$ref": "#/$defs/id" },
        "unseenCase": { "type": "boolean" },
        "sourceWorldModelRef": { "$ref": "#/$defs/entityRef" },
        "expectedGapObjectTypes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "decisionContext": { "type": "string" }
      }
    },
    "expertAssessment": {
      "type": "object",
      "required": ["id", "caseRef", "assessor", "role", "assessmentMode", "expectedFindings", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "caseRef": { "$ref": "#/$defs/id" },
        "assessor": { "type": "string" },
        "role": { "type": "string" },
        "assessmentMode": { "enum": ["blind-review", "panel-review", "adjudicated"] },
        "expectedFindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/calibratedFinding" }
        },
        "confidence": { "$ref": "#/$defs/score" }
      }
    },
    "agentAssessment": {
      "type": "object",
      "required": ["id", "caseRef", "generatedBy", "modelOrAgent", "assessmentMode", "generatedFindings", "confidence", "transcriptHandling"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "caseRef": { "$ref": "#/$defs/id" },
        "generatedBy": { "type": "string" },
        "modelOrAgent": { "type": "string" },
        "assessmentMode": { "enum": ["blind-review", "tool-assisted-review", "retrospective-review"] },
        "generatedFindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/calibratedFinding" }
        },
        "confidence": { "$ref": "#/$defs/score" },
        "transcriptHandling": { "type": "string" }
      }
    },
    "findingMatch": {
      "type": "object",
      "required": ["id", "caseRef", "expertAssessmentRef", "agentAssessmentRef", "matchType", "score", "rationale"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "caseRef": { "$ref": "#/$defs/id" },
        "expertAssessmentRef": { "$ref": "#/$defs/id" },
        "agentAssessmentRef": { "$ref": "#/$defs/id" },
        "expertFindingRef": { "$ref": "#/$defs/id" },
        "agentFindingRef": { "$ref": "#/$defs/id" },
        "matchType": { "enum": ["exact", "partial", "missed", "spurious", "disagreement"] },
        "score": { "$ref": "#/$defs/score" },
        "rationale": { "type": "string" }
      }
    },
    "evaluationSuiteHealthRecord": {
      "type": "object",
      "required": ["id", "title", "calibrationRunRef", "policyRef", "caseRefs", "taskOrigin", "contamination", "solvability", "saturation", "graders", "harness", "infrastructure", "drift", "overallStatus", "governanceTriggerRefs", "assuranceBoundary"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "calibrationRunRef": { "$ref": "#/$defs/id" },
        "policyRef": { "$ref": "#/$defs/id" },
        "caseRefs": { "$ref": "#/$defs/refArray" },
        "taskOrigin": {
          "type": "object",
          "required": ["evidenceOriginRefs", "distributionSummary", "status"],
          "additionalProperties": false,
          "properties": {
            "evidenceOriginRefs": { "$ref": "#/$defs/refArray" },
            "distributionSummary": { "type": "string", "minLength": 1 },
            "status": { "enum": ["verified", "provisional", "unknown"] }
          }
        },
        "contamination": {
          "type": "object",
          "required": ["checkMethod", "finding", "status"],
          "additionalProperties": false,
          "properties": {
            "checkMethod": { "type": "string", "minLength": 1 },
            "finding": { "type": "string", "minLength": 1 },
            "status": { "enum": ["clear", "possible", "confirmed", "unknown"] }
          }
        },
        "solvability": {
          "type": "object",
          "required": ["reviewMethod", "reviewedCaseRefs", "unresolvedCaseRefs", "status"],
          "additionalProperties": false,
          "properties": {
            "reviewMethod": { "type": "string", "minLength": 1 },
            "reviewedCaseRefs": { "$ref": "#/$defs/refArray" },
            "unresolvedCaseRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "status": { "enum": ["verified", "provisional", "blocked", "unknown"] }
          }
        },
        "saturation": {
          "type": "object",
          "required": ["detectionMethod", "saturated", "rationale", "status"],
          "additionalProperties": false,
          "properties": {
            "detectionMethod": { "type": "string", "minLength": 1 },
            "saturated": { "type": "boolean" },
            "rationale": { "type": "string", "minLength": 1 },
            "status": { "enum": ["not-saturated", "at-risk", "saturated", "unknown"] }
          }
        },
        "graders": {
          "type": "object",
          "required": ["expertAssessmentRefs", "agentAssessmentRefs", "calibrationMethod", "disagreementPolicy", "status"],
          "additionalProperties": false,
          "properties": {
            "expertAssessmentRefs": { "$ref": "#/$defs/refArray" },
            "agentAssessmentRefs": { "$ref": "#/$defs/refArray" },
            "calibrationMethod": { "type": "string", "minLength": 1 },
            "disagreementPolicy": { "type": "string", "minLength": 1 },
            "status": { "enum": ["calibrated", "provisional", "conflicted", "unknown"] }
          }
        },
        "harness": {
          "type": "object",
          "required": ["configuration", "reproducibilityEvidence", "status"],
          "additionalProperties": false,
          "properties": {
            "configuration": { "type": "string", "minLength": 1 },
            "reproducibilityEvidence": { "type": "string", "minLength": 1 },
            "status": { "enum": ["reproducible", "provisional", "non-reproducible", "unknown"] }
          }
        },
        "infrastructure": {
          "type": "object",
          "required": ["environment", "configuration", "incidentRefs", "status"],
          "additionalProperties": false,
          "properties": {
            "environment": { "type": "string", "minLength": 1 },
            "configuration": { "type": "string", "minLength": 1 },
            "incidentRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "status": { "enum": ["stable", "degraded", "incident-open", "unknown"] }
          }
        },
        "drift": {
          "type": "object",
          "required": ["owner", "reviewCadence", "nextReviewAt", "triggerConditions", "status"],
          "additionalProperties": false,
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "reviewCadence": { "type": "string", "minLength": 1 },
            "nextReviewAt": { "type": "string", "minLength": 1 },
            "triggerConditions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
            "status": { "enum": ["monitored", "overdue", "unowned", "unknown"] }
          }
        },
        "overallStatus": { "enum": ["healthy", "provisional", "degraded", "blocked", "stale"] },
        "governanceTriggerRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "assuranceBoundary": { "type": "string", "minLength": 1 }
      }
    },
    "trialVarianceRecord": {
      "type": "object",
      "required": ["id", "title", "calibrationRunRef", "suiteHealthRecordRef", "evidenceOriginRefs", "metric", "trialMeasurements", "summary", "infrastructureProfiles", "infrastructureAssessment", "uncertaintyRange", "comparisonBoundary", "overallStatus", "governanceTriggerRefs", "assuranceBoundary"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "calibrationRunRef": { "$ref": "#/$defs/id" },
        "suiteHealthRecordRef": { "$ref": "#/$defs/id" },
        "evidenceOriginRefs": { "$ref": "#/$defs/refArray" },
        "metric": { "enum": ["agreementScore", "falsePositiveRate", "falseNegativeRate"] },
        "trialMeasurements": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "value", "infrastructureProfileRef", "observedAt", "included", "exclusionRationale"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "value": { "$ref": "#/$defs/score" },
              "infrastructureProfileRef": { "$ref": "#/$defs/id" },
              "observedAt": { "type": "string", "minLength": 1 },
              "included": { "type": "boolean" },
              "exclusionRationale": { "type": "string" }
            }
          }
        },
        "summary": {
          "type": "object",
          "required": ["includedTrialRefs", "trialCount", "mean", "minimum", "maximum", "observedRange"],
          "additionalProperties": false,
          "properties": {
            "includedTrialRefs": { "$ref": "#/$defs/refArray" },
            "trialCount": { "type": "integer", "minimum": 1 },
            "mean": { "$ref": "#/$defs/score" },
            "minimum": { "$ref": "#/$defs/score" },
            "maximum": { "$ref": "#/$defs/score" },
            "observedRange": { "$ref": "#/$defs/score" }
          }
        },
        "infrastructureProfiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "environment", "runtime", "resourceEnvelope", "timeLimit", "concurrency", "incidentRefs", "status"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "environment": { "type": "string", "minLength": 1 },
              "runtime": { "type": "string", "minLength": 1 },
              "resourceEnvelope": { "type": "string", "minLength": 1 },
              "timeLimit": { "type": "string", "minLength": 1 },
              "concurrency": { "type": "string", "minLength": 1 },
              "incidentRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "status": { "enum": ["stable", "degraded", "incident-open", "unknown"] }
            }
          }
        },
        "infrastructureAssessment": {
          "type": "object",
          "required": ["profileRefs", "controlledVariables", "knownDifferences", "potentialConfounders", "status"],
          "additionalProperties": false,
          "properties": {
            "profileRefs": { "$ref": "#/$defs/refArray" },
            "controlledVariables": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
            "knownDifferences": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "potentialConfounders": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "status": { "enum": ["controlled", "bounded", "unresolved", "incident-affected"] }
          }
        },
        "uncertaintyRange": {
          "type": "object",
          "required": ["rangeKind", "lower", "upper", "calculationMethod", "interpretation"],
          "additionalProperties": false,
          "properties": {
            "rangeKind": { "const": "observed-trial-range" },
            "lower": { "$ref": "#/$defs/score" },
            "upper": { "$ref": "#/$defs/score" },
            "calculationMethod": { "const": "minimum-and-maximum-of-included-trials" },
            "interpretation": { "type": "string", "minLength": 1 }
          }
        },
        "comparisonBoundary": {
          "type": "object",
          "required": ["minimumMeaningfulDifference", "exactComparisonAllowed", "rationale"],
          "additionalProperties": false,
          "properties": {
            "minimumMeaningfulDifference": { "$ref": "#/$defs/score" },
            "exactComparisonAllowed": { "type": "boolean" },
            "rationale": { "type": "string", "minLength": 1 }
          }
        },
        "overallStatus": { "enum": ["sufficient", "provisional", "blocked", "stale"] },
        "governanceTriggerRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "assuranceBoundary": { "type": "string", "minLength": 1 }
      }
    },
    "frameworkLearningRecord": {
      "type": "object",
      "required": ["id", "title", "calibrationRunRefs", "evidenceOriginRefs", "contradictedAssumption", "proposedChange", "governanceDecision", "implementation", "followUp", "overallStatus", "governanceTriggerRefs", "assuranceBoundary"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "calibrationRunRefs": { "$ref": "#/$defs/refArray" },
        "evidenceOriginRefs": { "$ref": "#/$defs/refArray" },
        "contradictedAssumption": {
          "type": "object",
          "required": ["statement", "priorRationale", "contradictionEvidenceRefs", "contradictionSummary", "status"],
          "additionalProperties": false,
          "properties": {
            "statement": { "type": "string", "minLength": 1 },
            "priorRationale": { "type": "string", "minLength": 1 },
            "contradictionEvidenceRefs": { "$ref": "#/$defs/refArray" },
            "contradictionSummary": { "type": "string", "minLength": 1 },
            "status": { "enum": ["supported", "contradicted", "contested", "unresolved"] }
          }
        },
        "proposedChange": {
          "type": "object",
          "required": ["targetArtifact", "changeType", "description", "expectedEffect"],
          "additionalProperties": false,
          "properties": {
            "targetArtifact": { "type": "string", "minLength": 1 },
            "changeType": { "enum": ["schema", "verifier", "guidance", "policy", "workflow", "example", "other"] },
            "description": { "type": "string", "minLength": 1 },
            "expectedEffect": { "type": "string", "minLength": 1 }
          }
        },
        "governanceDecision": {
          "type": "object",
          "required": ["decision", "decidedBy", "decidedAt", "rationale"],
          "additionalProperties": false,
          "properties": {
            "decision": { "enum": ["pending", "accepted", "rejected", "deferred", "rolled-back"] },
            "decidedBy": { "type": "string", "minLength": 1 },
            "decidedAt": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 }
          }
        },
        "implementation": {
          "type": "object",
          "required": ["status", "artifactRefs", "validationEvidenceRefs", "rollbackEvidenceRefs"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["not-started", "implemented", "not-applicable", "rolled-back"] },
            "artifactRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "validationEvidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "rollbackEvidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "followUp": {
          "type": "object",
          "required": ["owner", "reviewAt", "successCriteria", "rollbackCriteria"],
          "additionalProperties": false,
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "reviewAt": { "type": "string", "minLength": 1 },
            "successCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
            "rollbackCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
          }
        },
        "overallStatus": { "enum": ["proposed", "accepted", "implemented", "rejected", "rolled-back", "stale"] },
        "governanceTriggerRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "assuranceBoundary": { "type": "string", "minLength": 1 }
      }
    },
    "calibrationRun": {
      "type": "object",
      "required": [
        "id",
        "policyRef",
        "caseRefs",
        "expertAssessmentRefs",
        "agentAssessmentRefs",
        "findingMatchRefs",
        "suiteHealthRecordRefs",
        "trialVarianceRecordRefs",
        "frameworkLearningRecordRefs",
        "caseCount",
        "domainCoverage",
        "agreementScore",
        "falsePositiveRate",
        "falseNegativeRate",
        "conclusion",
        "governanceTriggerRefs",
        "residualRisk",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "policyRef": { "$ref": "#/$defs/id" },
        "caseRefs": { "$ref": "#/$defs/refArray" },
        "expertAssessmentRefs": { "$ref": "#/$defs/refArray" },
        "agentAssessmentRefs": { "$ref": "#/$defs/refArray" },
        "findingMatchRefs": { "$ref": "#/$defs/refArray" },
        "suiteHealthRecordRefs": { "$ref": "#/$defs/refArray" },
        "trialVarianceRecordRefs": { "$ref": "#/$defs/refArray" },
        "frameworkLearningRecordRefs": { "$ref": "#/$defs/refArray" },
        "caseCount": { "type": "integer", "minimum": 0 },
        "domainCoverage": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "agreementScore": { "$ref": "#/$defs/score" },
        "falsePositiveRate": { "$ref": "#/$defs/score" },
        "falseNegativeRate": { "$ref": "#/$defs/score" },
        "conclusion": { "enum": ["calibrated", "provisional", "failed"] },
        "governanceTriggerRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        },
        "residualRisk": { "type": "string" },
        "status": { "enum": ["draft", "reviewed", "accepted", "superseded"] }
      }
    },
    "governanceTrigger": {
      "type": "object",
      "required": ["id", "triggerType", "reason", "sourceCalibrationRunRef", "severity", "requiredAction", "owner", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "triggerType": { "enum": ["low-agreement", "high-false-positive-rate", "high-false-negative-rate", "insufficient-case-count", "insufficient-trial-count", "domain-gap", "expert-disagreement", "contamination-risk", "unsolvable-case", "suite-saturation", "grader-drift", "harness-non-reproducible", "infrastructure-instability", "trial-variance-unresolved", "framework-learning-review", "drift-unowned", "other"] },
        "reason": { "type": "string" },
        "sourceCalibrationRunRef": { "$ref": "#/$defs/id" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "requiredAction": { "type": "string" },
        "owner": { "type": "string" },
        "status": { "enum": ["open", "reviewed", "resolved"] }
      }
    },
    "verifierBoundary": {
      "type": "object",
      "required": ["checks", "doesNotClaim", "semanticValidityRequires"],
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "doesNotClaim": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "semanticValidityRequires": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    }
  }
}
