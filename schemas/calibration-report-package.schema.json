{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/qif/schemas/calibration-report-package.schema.json",
  "title": "QIF Calibration Report Package",
  "type": "object",
  "required": [
    "packageType",
    "runtimeVersion",
    "packageId",
    "packageRefs",
    "evidenceOrigins",
    "calibrationPolicies",
    "decisionOutcomePairs",
    "calibrationCohorts",
    "calibrationReports",
    "consequencePolicies",
    "decisionConsequences",
    "consequenceAssessments",
    "governanceTriggers",
    "verifierBoundary"
  ],
  "additionalProperties": false,
  "properties": {
    "packageType": { "const": "calibration-report" },
    "runtimeVersion": { "type": "string", "minLength": 1 },
    "packageId": { "$ref": "#/$defs/id" },
    "packageRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/packageRef" } },
    "evidenceOrigins": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceOrigin" } },
    "calibrationPolicies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/calibrationPolicy" } },
    "decisionOutcomePairs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decisionOutcomePair" } },
    "calibrationCohorts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/calibrationCohort" } },
    "calibrationReports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/calibrationReport" } },
    "consequencePolicies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/consequencePolicy" } },
    "decisionConsequences": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decisionConsequence" } },
    "consequenceAssessments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/consequenceAssessment" } },
    "governanceTriggers": { "type": "array", "items": { "$ref": "#/$defs/governanceTrigger" } },
    "verifierBoundary": { "$ref": "#/$defs/verifierBoundary" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z]+-[A-Z0-9-]+$" },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "refArray": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
    "packageRef": {
      "type": "object",
      "required": ["id", "path", "packageType", "role"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1 },
        "packageType": { "const": "quality-gate" },
        "role": { "const": "decision-outcome-source" }
      }
    },
    "evidenceOrigin": {
      "type": "object",
      "required": ["id", "originKind", "sourceArtifact", "observationWindow", "environment", "generatedBy", "verifiedBy", "transformationSummary", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "originKind": { "enum": ["observed-operational", "historical-record", "simulated", "synthetic", "example"] },
        "sourceArtifact": { "type": "string", "minLength": 1 },
        "observationWindow": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "generatedBy": { "type": "string", "minLength": 1 },
        "verifiedBy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "transformationSummary": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "verified", "stale", "retired"] }
      }
    },
    "bucketDefinition": {
      "type": "object",
      "required": ["id", "lowerInclusive", "upperExclusive"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "lowerInclusive": { "$ref": "#/$defs/score" },
        "upperExclusive": { "type": "number", "exclusiveMinimum": 0, "maximum": 1.000001 }
      }
    },
    "calibrationPolicy": {
      "type": "object",
      "required": ["id", "predictionMeaning", "outcomeMeaning", "scoreRule", "roundingDecimals", "minimumPairCount", "minimumEmpiricalPairCount", "maximumAcceptableBrierScore", "maximumAcceptableBucketGap", "bucketDefinitions", "insufficientDataAction", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "predictionMeaning": { "type": "string", "minLength": 1 },
        "outcomeMeaning": { "type": "string", "minLength": 1 },
        "scoreRule": { "const": "mean-squared-probability-error" },
        "roundingDecimals": { "type": "integer", "minimum": 2, "maximum": 6 },
        "minimumPairCount": { "type": "integer", "minimum": 2 },
        "minimumEmpiricalPairCount": { "type": "integer", "minimum": 2 },
        "maximumAcceptableBrierScore": { "$ref": "#/$defs/score" },
        "maximumAcceptableBucketGap": { "$ref": "#/$defs/score" },
        "bucketDefinitions": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/bucketDefinition" } },
        "insufficientDataAction": { "const": "governance-review" },
        "status": { "enum": ["draft", "active", "retired"] }
      }
    },
    "decisionOutcomePair": {
      "type": "object",
      "required": ["id", "sourcePackageRef", "gateDecisionRef", "outcomeReviewRef", "sourceEvidenceOriginRef", "evidenceOriginRef", "sourceConfidence", "forecastProbability", "confidenceTransformation", "confidenceMeaning", "observedOutcome", "outcomeValue", "outcomeRationale", "observationWindow", "domain", "included", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourcePackageRef": { "$ref": "#/$defs/id" },
        "gateDecisionRef": { "$ref": "#/$defs/id" },
        "outcomeReviewRef": { "$ref": "#/$defs/id" },
        "sourceEvidenceOriginRef": { "$ref": "#/$defs/id" },
        "evidenceOriginRef": { "$ref": "#/$defs/id" },
        "sourceConfidence": { "$ref": "#/$defs/score" },
        "forecastProbability": { "$ref": "#/$defs/score" },
        "confidenceTransformation": {
          "type": "object",
          "required": ["method", "rationale", "reviewedBy"],
          "additionalProperties": false,
          "properties": {
            "method": { "const": "identity" },
            "rationale": { "type": "string", "minLength": 1 },
            "reviewedBy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "confidenceMeaning": { "type": "string", "minLength": 1 },
        "observedOutcome": { "enum": ["protected-outcome-held", "protected-outcome-failed"] },
        "outcomeValue": { "enum": [0, 1] },
        "outcomeRationale": { "type": "string", "minLength": 1 },
        "observationWindow": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "included": { "type": "boolean" },
        "exclusionRationale": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "reviewed", "retired"] }
      }
    },
    "calibrationBucket": {
      "type": "object",
      "required": ["bucketRef", "pairRefs", "pairCount", "meanForecastProbability", "observedSuccessRate", "calibrationGap"],
      "additionalProperties": false,
      "properties": {
        "bucketRef": { "$ref": "#/$defs/id" },
        "pairRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "pairCount": { "type": "integer", "minimum": 0 },
        "meanForecastProbability": { "$ref": "#/$defs/score" },
        "observedSuccessRate": { "$ref": "#/$defs/score" },
        "calibrationGap": { "$ref": "#/$defs/score" }
      }
    },
    "eligibleDecision": {
      "type": "object",
      "required": ["sourcePackageRef", "gateDecisionRef"],
      "additionalProperties": false,
      "properties": {
        "sourcePackageRef": { "$ref": "#/$defs/id" },
        "gateDecisionRef": { "$ref": "#/$defs/id" }
      }
    },
    "missingOutcomeDecision": {
      "type": "object",
      "required": ["sourcePackageRef", "gateDecisionRef", "rationale"],
      "additionalProperties": false,
      "properties": {
        "sourcePackageRef": { "$ref": "#/$defs/id" },
        "gateDecisionRef": { "$ref": "#/$defs/id" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "selectionRule": {
      "type": "object",
      "required": ["id", "field", "operator", "values", "effect", "rationale"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "field": { "enum": ["domain", "observedOutcome", "status", "sourceEvidenceOriginKind"] },
        "operator": { "enum": ["equals", "in", "not-equals"] },
        "values": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "effect": { "enum": ["include", "exclude"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "excludedPair": {
      "type": "object",
      "required": ["pairRef", "ruleRef", "rationale"],
      "additionalProperties": false,
      "properties": {
        "pairRef": { "$ref": "#/$defs/id" },
        "ruleRef": { "$ref": "#/$defs/id" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "duplicateGroup": {
      "type": "object",
      "required": ["key", "pairRefs"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "pairRefs": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "independenceBoundary": {
      "type": "object",
      "required": ["unitOfAnalysis", "duplicateKeyFields", "duplicateGroups", "dependenceRisks", "status"],
      "additionalProperties": false,
      "properties": {
        "unitOfAnalysis": { "type": "string", "minLength": 1 },
        "duplicateKeyFields": { "type": "array", "minItems": 1, "items": { "enum": ["sourcePackageRef", "gateDecisionRef", "outcomeReviewRef", "observationWindow"] } },
        "duplicateGroups": { "type": "array", "items": { "$ref": "#/$defs/duplicateGroup" } },
        "dependenceRisks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "status": { "enum": ["clear", "bounded", "unresolved"] }
      }
    },
    "segmentDefinition": {
      "type": "object",
      "required": ["id", "dimension", "highRiskValues", "rationale"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "dimension": { "enum": ["domain", "observedOutcome", "sourceEvidenceOriginKind"] },
        "highRiskValues": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "segmentSummary": {
      "type": "object",
      "required": ["segmentRef", "value", "pairRefs", "pairCount", "outcomePrevalence", "brierScore", "highRisk"],
      "additionalProperties": false,
      "properties": {
        "segmentRef": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "minLength": 1 },
        "pairRefs": { "$ref": "#/$defs/refArray" },
        "pairCount": { "type": "integer", "minimum": 1 },
        "outcomePrevalence": { "$ref": "#/$defs/score" },
        "brierScore": { "$ref": "#/$defs/score" },
        "highRisk": { "type": "boolean" }
      }
    },
    "cohortCompletenessSummary": {
      "type": "object",
      "required": ["eligibleDecisionCount", "candidatePairCount", "includedPairCount", "excludedPairCount", "missingOutcomeCount", "coverageRate", "outcomePrevalence"],
      "additionalProperties": false,
      "properties": {
        "eligibleDecisionCount": { "type": "integer", "minimum": 1 },
        "candidatePairCount": { "type": "integer", "minimum": 0 },
        "includedPairCount": { "type": "integer", "minimum": 0 },
        "excludedPairCount": { "type": "integer", "minimum": 0 },
        "missingOutcomeCount": { "type": "integer", "minimum": 0 },
        "coverageRate": { "$ref": "#/$defs/score" },
        "outcomePrevalence": { "$ref": "#/$defs/score" }
      }
    },
    "driftAssessment": {
      "type": "object",
      "required": ["comparisonBasis", "dimensions", "status", "rationale"],
      "additionalProperties": false,
      "properties": {
        "baselineCohortRef": { "$ref": "#/$defs/id" },
        "comparisonBasis": { "type": "string", "minLength": 1 },
        "dimensions": { "type": "array", "minItems": 1, "items": { "enum": ["domain", "outcomePrevalence", "sourceEvidenceOriginKind", "forecastProbability"] } },
        "status": { "enum": ["not-assessed", "stable", "drift-detected"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "calibrationCohort": {
      "type": "object",
      "required": ["id", "title", "policyRef", "eligibleDecisions", "candidatePairRefs", "selectionRules", "includedPairRefs", "excludedPairs", "missingOutcomeDecisions", "independenceBoundary", "segmentDefinitions", "segmentSummaries", "completenessSummary", "driftAssessment", "governanceTriggerRefs", "interpretation", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "policyRef": { "$ref": "#/$defs/id" },
        "eligibleDecisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/eligibleDecision" } },
        "candidatePairRefs": { "$ref": "#/$defs/refArray" },
        "selectionRules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/selectionRule" } },
        "includedPairRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "excludedPairs": { "type": "array", "items": { "$ref": "#/$defs/excludedPair" } },
        "missingOutcomeDecisions": { "type": "array", "items": { "$ref": "#/$defs/missingOutcomeDecision" } },
        "independenceBoundary": { "$ref": "#/$defs/independenceBoundary" },
        "segmentDefinitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/segmentDefinition" } },
        "segmentSummaries": { "type": "array", "items": { "$ref": "#/$defs/segmentSummary" } },
        "completenessSummary": { "$ref": "#/$defs/cohortCompletenessSummary" },
        "driftAssessment": { "$ref": "#/$defs/driftAssessment" },
        "governanceTriggerRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "interpretation": { "const": "cohort-evidence-only-not-representativeness-or-quality" },
        "status": { "enum": ["provisional", "reviewed", "retired"] }
      }
    },
    "consequencePolicy": {
      "type": "object",
      "required": ["id", "sourcePackageRef", "qualityIntentRef", "lossBoundary", "lossBoundarySeverity", "actionThreshold", "thresholdMeaning", "falseAssuranceWeight", "falseAlarmWeight", "weightSemantics", "roundingDecimals", "minimumPairCount", "maximumAcceptableWeightedErrorRate", "severeFalseAssuranceAction", "reviewedBy", "governanceTriggerRefs", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourcePackageRef": { "$ref": "#/$defs/id" },
        "qualityIntentRef": { "$ref": "#/$defs/id" },
        "lossBoundary": { "type": "string", "minLength": 1 },
        "lossBoundarySeverity": { "enum": ["low", "medium", "high", "critical"] },
        "actionThreshold": { "$ref": "#/$defs/score" },
        "thresholdMeaning": { "const": "proceed-when-forecast-at-or-above-threshold" },
        "falseAssuranceWeight": { "type": "integer", "minimum": 1, "maximum": 10 },
        "falseAlarmWeight": { "type": "integer", "minimum": 1, "maximum": 10 },
        "weightSemantics": { "const": "policy-local-governance-priority-not-harm-or-money" },
        "roundingDecimals": { "type": "integer", "minimum": 2, "maximum": 6 },
        "minimumPairCount": { "type": "integer", "minimum": 2 },
        "maximumAcceptableWeightedErrorRate": { "$ref": "#/$defs/score" },
        "severeFalseAssuranceAction": { "const": "governance-review" },
        "reviewedBy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "governanceTriggerRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "status": { "enum": ["draft", "active", "retired"] }
      }
    },
    "decisionConsequence": {
      "type": "object",
      "required": ["id", "pairRef", "policyRef", "forecastProbability", "actionThreshold", "recommendedAction", "observedOutcome", "consequenceClass", "applicableWeight", "weightedError", "rationale", "governanceTriggerRefs", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "pairRef": { "$ref": "#/$defs/id" },
        "policyRef": { "$ref": "#/$defs/id" },
        "forecastProbability": { "$ref": "#/$defs/score" },
        "actionThreshold": { "$ref": "#/$defs/score" },
        "recommendedAction": { "enum": ["proceed", "defer"] },
        "observedOutcome": { "enum": ["protected-outcome-held", "protected-outcome-failed"] },
        "consequenceClass": { "enum": ["aligned-proceed", "aligned-defer", "false-assurance", "false-alarm"] },
        "applicableWeight": { "type": "integer", "minimum": 1, "maximum": 10 },
        "weightedError": { "type": "number", "minimum": 0, "maximum": 10 },
        "rationale": { "type": "string", "minLength": 1 },
        "governanceTriggerRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "status": { "enum": ["draft", "reviewed", "retired"] }
      }
    },
    "consequenceAssessment": {
      "type": "object",
      "required": ["id", "title", "policyRef", "decisionConsequenceRefs", "pairCount", "falseAssuranceCount", "falseAlarmCount", "alignedCount", "totalApplicableWeight", "totalWeightedError", "weightedErrorRate", "maximumAcceptableWeightedErrorRate", "assessmentSignal", "governanceTriggerRefs", "interpretation", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "policyRef": { "$ref": "#/$defs/id" },
        "decisionConsequenceRefs": { "$ref": "#/$defs/refArray" },
        "pairCount": { "type": "integer", "minimum": 1 },
        "falseAssuranceCount": { "type": "integer", "minimum": 0 },
        "falseAlarmCount": { "type": "integer", "minimum": 0 },
        "alignedCount": { "type": "integer", "minimum": 0 },
        "totalApplicableWeight": { "type": "integer", "minimum": 1 },
        "totalWeightedError": { "type": "number", "minimum": 0 },
        "weightedErrorRate": { "$ref": "#/$defs/score" },
        "maximumAcceptableWeightedErrorRate": { "$ref": "#/$defs/score" },
        "assessmentSignal": { "enum": ["insufficient-data", "within-policy-tolerance", "above-policy-tolerance"] },
        "governanceTriggerRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "interpretation": { "const": "policy-local-decision-evidence-only-not-quality-or-authority" },
        "status": { "enum": ["draft", "reviewed", "retired"] }
      }
    },
    "uncertaintyBoundary": {
      "type": "object",
      "required": ["pairCount", "empiricalPairCount", "minimumPairCount", "minimumEmpiricalPairCount", "dataSufficiency", "limitations"],
      "additionalProperties": false,
      "properties": {
        "pairCount": { "type": "integer", "minimum": 0 },
        "empiricalPairCount": { "type": "integer", "minimum": 0 },
        "minimumPairCount": { "type": "integer", "minimum": 2 },
        "minimumEmpiricalPairCount": { "type": "integer", "minimum": 2 },
        "dataSufficiency": { "enum": ["insufficient", "provisional", "sufficient"] },
        "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "calibrationReport": {
      "type": "object",
      "required": ["id", "title", "policyRef", "includedPairRefs", "excludedPairRefs", "evidenceOriginRefs", "brierScore", "buckets", "uncertaintyBoundary", "calibrationSignal", "interpretation", "governanceTriggerRefs", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "policyRef": { "$ref": "#/$defs/id" },
        "includedPairRefs": { "$ref": "#/$defs/refArray" },
        "excludedPairRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "evidenceOriginRefs": { "$ref": "#/$defs/refArray" },
        "brierScore": { "$ref": "#/$defs/score" },
        "buckets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/calibrationBucket" } },
        "uncertaintyBoundary": { "$ref": "#/$defs/uncertaintyBoundary" },
        "calibrationSignal": { "enum": ["insufficient-data", "descriptive-only", "possible-underconfidence", "possible-overconfidence", "mixed", "within-policy-tolerance"] },
        "interpretation": { "const": "evidence-only-not-quality-verdict" },
        "governanceTriggerRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "status": { "enum": ["draft", "reviewed", "retired"] }
      }
    },
    "governanceTrigger": {
      "type": "object",
      "required": ["id", "triggerType", "reason", "sourceCalibrationReportRef", "severity", "requiredAction", "owner", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "triggerType": { "enum": ["insufficient-data", "non-empirical-evidence", "confidence-semantics-mismatch", "calculation-mismatch", "calibration-gap", "stale-evidence", "missing-outcomes", "duplicate-observations", "dependence-unresolved", "high-risk-segment-gap", "drift-not-assessed", "drift-detected", "consequence-policy-unreviewed", "severe-false-assurance", "consequence-threshold-exceeded", "other"] },
        "reason": { "type": "string", "minLength": 1 },
        "sourceCalibrationReportRef": { "$ref": "#/$defs/id" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "requiredAction": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "reviewed", "resolved", "retired"] },
        "resultingGovernanceEventRef": { "$ref": "#/$defs/id" }
      }
    },
    "verifierBoundary": {
      "type": "object",
      "required": ["checks", "doesNotClaim", "semanticValidityRequires"],
      "additionalProperties": false,
      "properties": {
        "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "doesNotClaim": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "semanticValidityRequires": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
