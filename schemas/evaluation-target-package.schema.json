{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/qif/schemas/evaluation-target-package.schema.json",
  "title": "QIF Evaluation Target Package",
  "type": "object",
  "required": [
    "packageType",
    "runtimeVersion",
    "packageId",
    "evaluationTargets"
  ],
  "additionalProperties": false,
  "properties": {
    "packageType": { "const": "evaluation-target" },
    "runtimeVersion": { "type": "string" },
    "packageId": { "type": "string" },
    "evaluationTargets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evaluationTarget" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+-[A-Z0-9-]+$"
    },
    "stakeholderImpact": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "sourceEvidence": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "evaluationTarget": {
      "type": "object",
      "required": [
        "id",
        "title",
        "domain",
        "targetType",
        "artifactType",
        "context",
        "stakeholderImpact",
        "operationalImpact",
        "riskSummary",
        "sourceEvidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "domain": {
          "enum": ["software-development", "product-development", "service-operations", "accounting", "administration", "maintenance", "customer-support"]
        },
        "targetType": { "type": "string" },
        "artifactType": { "type": "string" },
        "context": { "type": "string" },
        "stakeholderImpact": { "$ref": "#/$defs/stakeholderImpact" },
        "operationalImpact": { "type": "string" },
        "riskSummary": { "type": "string" },
        "sourceEvidence": { "$ref": "#/$defs/sourceEvidence" }
      }
    }
  }
}
