{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-org-labs.example/qif/agent-skill-portability-package.schema.json",
  "title": "QIF Agent Skill Behavioral Portability Package",
  "type": "object",
  "required": ["packageType", "runtimeVersion", "packageId", "skillArtifacts", "clientProfiles", "portabilityCases", "behaviorCriteria", "portabilityRuns", "matchedRunPairs", "portabilityAssessments", "governanceTriggers", "verifierBoundary"],
  "additionalProperties": false,
  "properties": {
    "packageType": { "const": "agent-skill-portability" },
    "runtimeVersion": { "type": "string", "minLength": 1 },
    "packageId": { "$ref": "#/$defs/id" },
    "skillArtifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/skillArtifact" } },
    "clientProfiles": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/clientProfile" } },
    "portabilityCases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/portabilityCase" } },
    "behaviorCriteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/behaviorCriterion" } },
    "portabilityRuns": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/portabilityRun" } },
    "matchedRunPairs": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/matchedRunPair" } },
    "portabilityAssessments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/portabilityAssessment" } },
    "governanceTriggers": { "type": "array", "items": { "$ref": "#/$defs/governanceTrigger" } },
    "verifierBoundary": { "$ref": "#/$defs/verifierBoundary" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z]+-[A-Z0-9-]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "skillArtifact": {
      "type": "object", "required": ["id", "name", "version", "sourcePath", "artifactDigest", "format", "verifiedBy", "status"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "sourcePath": { "type": "string", "minLength": 1 }, "artifactDigest": { "$ref": "#/$defs/digest" }, "format": { "const": "agent-skills" }, "verifiedBy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "status": { "enum": ["verified-structure", "unverified"] } }
    },
    "clientProfile": {
      "type": "object", "required": ["id", "clientFamily", "clientVersion", "modelIdentity", "skillDiscoveryMode", "invocationMode", "toolSurface", "environmentDigest", "operator", "independenceGroup", "status"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "clientFamily": { "type": "string", "minLength": 1 }, "clientVersion": { "type": "string", "minLength": 1 }, "modelIdentity": { "type": "string", "minLength": 1 }, "skillDiscoveryMode": { "enum": ["automatic", "explicit", "unsupported", "unknown"] }, "invocationMode": { "enum": ["implicit", "explicit", "both", "none"] }, "toolSurface": { "type": "string", "minLength": 1 }, "environmentDigest": { "$ref": "#/$defs/digest" }, "operator": { "type": "string", "minLength": 1 }, "independenceGroup": { "type": "string", "minLength": 1 }, "status": { "enum": ["declared", "verified"] } }
    },
    "portabilityCase": {
      "type": "object", "required": ["id", "title", "inputArtifact", "inputDigest", "taskPrompt", "expectedCriterionRefs", "lossBoundary", "sensitiveDataHandling", "status"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "inputArtifact": { "type": "string", "minLength": 1 }, "inputDigest": { "$ref": "#/$defs/digest" }, "taskPrompt": { "type": "string", "minLength": 1 }, "expectedCriterionRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "lossBoundary": { "type": "string", "minLength": 1 }, "sensitiveDataHandling": { "type": "string", "minLength": 1 }, "status": { "enum": ["ready", "retired"] } }
    },
    "behaviorCriterion": {
      "type": "object", "required": ["id", "dimension", "observableBehavior", "minimumSkillScore", "blocking", "rationale"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "dimension": { "enum": ["discovery-routing", "quality-intent", "evidence-traceability", "non-functional-coverage", "world-model-gaps", "safety-authority-boundary", "output-conformance"] }, "observableBehavior": { "type": "string", "minLength": 1 }, "minimumSkillScore": { "type": "integer", "minimum": 0, "maximum": 2 }, "blocking": { "type": "boolean" }, "rationale": { "type": "string", "minLength": 1 } }
    },
    "criterionResult": {
      "type": "object", "required": ["criterionRef", "score", "observation", "evidenceRefs"], "additionalProperties": false,
      "properties": { "criterionRef": { "$ref": "#/$defs/id" }, "score": { "type": "integer", "minimum": 0, "maximum": 2 }, "observation": { "type": "string", "minLength": 1 }, "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
    },
    "portabilityRun": {
      "type": "object", "required": ["id", "clientRef", "caseRef", "condition", "skillArtifactRef", "inputDigest", "modelConfigDigest", "toolConfigDigest", "startedAt", "completedAt", "transcriptRef", "transcriptDigest", "criterionResults", "evidenceStatus", "activityCountIsQuality", "semanticTruthClaimed", "status"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "clientRef": { "$ref": "#/$defs/id" }, "caseRef": { "$ref": "#/$defs/id" }, "condition": { "enum": ["baseline", "skill-enabled"] }, "skillArtifactRef": { "type": ["string", "null"] }, "inputDigest": { "$ref": "#/$defs/digest" }, "modelConfigDigest": { "$ref": "#/$defs/digest" }, "toolConfigDigest": { "$ref": "#/$defs/digest" }, "startedAt": { "type": "string", "format": "date-time" }, "completedAt": { "type": "string", "format": "date-time" }, "transcriptRef": { "type": "string", "minLength": 1 }, "transcriptDigest": { "$ref": "#/$defs/digest" }, "criterionResults": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterionResult" } }, "evidenceStatus": { "enum": ["verified", "unverified", "example-only"] }, "activityCountIsQuality": { "const": false }, "semanticTruthClaimed": { "const": false }, "status": { "enum": ["completed", "governance-required"] } }
    },
    "matchedRunPair": {
      "type": "object", "required": ["id", "clientRef", "caseRef", "baselineRunRef", "skillRunRef", "sameInput", "sameModelConfig", "sameToolConfig", "criterionDeltaTotal", "regressionCriterionRefs", "improvementCriterionRefs", "evidenceStatus", "status"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "clientRef": { "$ref": "#/$defs/id" }, "caseRef": { "$ref": "#/$defs/id" }, "baselineRunRef": { "$ref": "#/$defs/id" }, "skillRunRef": { "$ref": "#/$defs/id" }, "sameInput": { "type": "boolean" }, "sameModelConfig": { "type": "boolean" }, "sameToolConfig": { "type": "boolean" }, "criterionDeltaTotal": { "type": "integer" }, "regressionCriterionRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "improvementCriterionRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "evidenceStatus": { "enum": ["verified", "unverified", "example-only"] }, "status": { "enum": ["reviewed", "governance-required"] } }
    },
    "portabilityAssessment": {
      "type": "object", "required": ["id", "skillArtifactRef", "caseRefs", "clientRefs", "pairRefs", "clientCount", "pairCount", "criteriaCoverageComplete", "matchedConfigurationComplete", "aggregateCriterionDelta", "regressionCount", "blockingFailureRefs", "evidenceStatus", "outcome", "rationale", "governanceTriggerRefs", "activityCountIsQuality", "agreementIsTruth", "automaticAuthority", "semanticTruthClaimed", "status"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "skillArtifactRef": { "$ref": "#/$defs/id" }, "caseRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "clientRefs": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "pairRefs": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "clientCount": { "type": "integer", "minimum": 0 }, "pairCount": { "type": "integer", "minimum": 0 }, "criteriaCoverageComplete": { "type": "boolean" }, "matchedConfigurationComplete": { "type": "boolean" }, "aggregateCriterionDelta": { "type": "integer" }, "regressionCount": { "type": "integer", "minimum": 0 }, "blockingFailureRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "evidenceStatus": { "enum": ["verified", "unverified", "example-only"] }, "outcome": { "enum": ["portable-candidate", "not-portable", "governance-required"] }, "rationale": { "type": "string", "minLength": 1 }, "governanceTriggerRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "activityCountIsQuality": { "const": false }, "agreementIsTruth": { "const": false }, "automaticAuthority": { "const": false }, "semanticTruthClaimed": { "const": false }, "status": { "enum": ["reviewed", "governance-required"] } }
    },
    "governanceTrigger": {
      "type": "object", "required": ["id", "triggerType", "reason", "severity", "requiredAction", "owner", "status"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "triggerType": { "enum": ["portability-evidence-unverified", "configuration-mismatch", "blocking-behavior-failure", "cross-client-disagreement"] }, "reason": { "type": "string", "minLength": 1 }, "severity": { "enum": ["low", "medium", "high", "critical"] }, "requiredAction": { "type": "string", "minLength": 1 }, "owner": { "type": "string", "minLength": 1 }, "status": { "enum": ["open", "closed"] } }
    },
    "verifierBoundary": {
      "type": "object", "required": ["checks", "doesNotClaim", "semanticValidityRequires"], "additionalProperties": false,
      "properties": { "checks": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "doesNotClaim": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "semanticValidityRequires": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
    }
  }
}
