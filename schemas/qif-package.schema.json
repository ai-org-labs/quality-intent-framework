{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/qif/schemas/qif-package.schema.json",
  "title": "Quality Intent Framework Package",
  "type": "object",
  "required": [
    "qifVersion",
    "packageId",
    "missions",
    "stakeholders",
    "contexts",
    "risks",
    "knowledgeSources",
    "qualityIntents",
    "evidenceItems",
    "evaluations",
    "governanceEvents",
    "acceptanceGates"
  ],
  "additionalProperties": false,
  "properties": {
    "qifVersion": { "type": "string" },
    "packageId": { "type": "string" },
    "title": { "type": "string" },
    "missions": {
      "type": "array",
      "items": { "$ref": "#/$defs/mission" }
    },
    "stakeholders": {
      "type": "array",
      "items": { "$ref": "#/$defs/stakeholder" }
    },
    "contexts": {
      "type": "array",
      "items": { "$ref": "#/$defs/context" }
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk" }
    },
    "knowledgeSources": {
      "type": "array",
      "items": { "$ref": "#/$defs/knowledgeSource" }
    },
    "qualityIntents": {
      "type": "array",
      "items": { "$ref": "#/$defs/qualityIntent" }
    },
    "evidenceItems": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "indicators": {
      "type": "array",
      "items": { "$ref": "#/$defs/indicator" },
      "default": []
    },
    "evaluations": {
      "type": "array",
      "items": { "$ref": "#/$defs/evaluation" }
    },
    "governanceEvents": {
      "type": "array",
      "items": { "$ref": "#/$defs/governanceEvent" }
    },
    "acceptanceGates": {
      "type": "array",
      "items": { "$ref": "#/$defs/acceptanceGate" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+-[A-Z0-9-]+$"
    },
    "refArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "minItems": 1
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "mission": {
      "type": "object",
      "required": ["id", "statement", "stakeholderRefs", "contextRefs", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string" },
        "stakeholderRefs": { "$ref": "#/$defs/refArray" },
        "contextRefs": { "$ref": "#/$defs/refArray" },
        "status": { "enum": ["proposed", "active", "revised", "retired"] }
      }
    },
    "stakeholder": {
      "type": "object",
      "required": ["id", "name", "category", "needs", "harmsToAvoid"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "needs": { "type": "array", "items": { "type": "string" } },
        "harmsToAvoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "context": {
      "type": "object",
      "required": ["id", "scope", "domain", "constraints", "assumptions", "timeHorizon"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "scope": { "type": "string" },
        "domain": { "type": "string" },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "timeHorizon": { "type": "string" }
      }
    },
    "risk": {
      "type": "object",
      "required": ["id", "statement", "stakeholderRefs", "contextRefs", "severity", "likelihood", "detectability", "riskAppetite", "lossBoundary"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string" },
        "stakeholderRefs": { "$ref": "#/$defs/refArray" },
        "contextRefs": { "$ref": "#/$defs/refArray" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "likelihood": { "enum": ["rare", "unlikely", "possible", "likely", "frequent"] },
        "detectability": { "enum": ["easy", "moderate", "hard", "unknown"] },
        "riskAppetite": { "enum": ["averse", "minimal", "cautious", "open", "hungry"] },
        "lossBoundary": { "type": "string" }
      }
    },
    "knowledgeSource": {
      "type": "object",
      "required": ["id", "sourceType", "title", "owner", "reliability", "accessMode", "extractionMethod"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceType": { "enum": ["document", "project-history", "operation", "expertise", "audit", "external-standard", "measurement"] },
        "title": { "type": "string" },
        "owner": { "type": "string" },
        "reliability": { "$ref": "#/$defs/score" },
        "accessMode": { "enum": ["direct", "interview", "observation", "sample", "derived"] },
        "extractionMethod": { "type": "string" }
      }
    },
    "qualityIntent": {
      "type": "object",
      "required": ["id", "statement", "purpose", "stakeholderRefs", "contextRefs", "riskRefs", "sourceRefs", "governanceOwner", "status", "acceptanceCriteria"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string" },
        "purpose": { "type": "string" },
        "stakeholderRefs": { "$ref": "#/$defs/refArray" },
        "contextRefs": { "$ref": "#/$defs/refArray" },
        "riskRefs": { "$ref": "#/$defs/refArray" },
        "sourceRefs": { "$ref": "#/$defs/refArray" },
        "governanceOwner": { "type": "string" },
        "status": { "enum": ["discovered", "candidate", "validated", "active", "revised", "deprecated", "retired"] },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "confidenceInputs": {
      "type": "object",
      "required": ["sourceReliability", "relevance", "coverage", "recency", "independence", "contradictionPenalty"],
      "additionalProperties": false,
      "properties": {
        "sourceReliability": { "$ref": "#/$defs/score" },
        "relevance": { "$ref": "#/$defs/score" },
        "coverage": { "$ref": "#/$defs/score" },
        "recency": { "$ref": "#/$defs/score" },
        "independence": { "$ref": "#/$defs/score" },
        "contradictionPenalty": { "$ref": "#/$defs/score" }
      }
    },
    "evidenceItem": {
      "type": "object",
      "required": ["id", "sourceRef", "intentRefs", "method", "finding", "polarity", "confidenceInputs", "confidence", "collectedAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceRef": { "$ref": "#/$defs/id" },
        "intentRefs": { "$ref": "#/$defs/refArray" },
        "method": { "type": "string" },
        "finding": { "type": "string" },
        "polarity": { "enum": ["supports", "contradicts", "mixed"] },
        "confidenceInputs": { "$ref": "#/$defs/confidenceInputs" },
        "confidence": { "$ref": "#/$defs/score" },
        "collectedAt": { "type": "string" }
      }
    },
    "indicator": {
      "type": "object",
      "required": ["id", "name", "metricKind", "value", "unit", "interpretation", "linkedIntentRef", "linkedRiskRef"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "metricKind": { "enum": ["activity-count", "outcome", "risk-signal", "experience-signal", "control-signal"] },
        "value": { "type": ["number", "string"] },
        "unit": { "type": "string" },
        "interpretation": { "enum": ["evidence-only", "quality-itself"] },
        "linkedIntentRef": { "$ref": "#/$defs/id" },
        "linkedRiskRef": { "$ref": "#/$defs/id" }
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["id", "scope", "evaluatedIntentRefs", "evidenceRefs", "confidencePolicy", "verdicts", "evaluatorRefs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "scope": { "type": "string" },
        "evaluatedIntentRefs": { "$ref": "#/$defs/refArray" },
        "evidenceRefs": { "$ref": "#/$defs/refArray" },
        "confidencePolicy": {
          "type": "object",
          "required": ["partialThreshold", "achievedThreshold"],
          "additionalProperties": false,
          "properties": {
            "partialThreshold": { "$ref": "#/$defs/score" },
            "achievedThreshold": { "$ref": "#/$defs/score" }
          }
        },
        "verdicts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/verdict" }
        },
        "evaluatorRefs": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["intentRef", "decision", "confidence", "evidenceRefs", "rationale", "residualRisk"],
      "additionalProperties": false,
      "properties": {
        "intentRef": { "$ref": "#/$defs/id" },
        "decision": { "enum": ["achieved", "partially-achieved", "not-achieved", "inconclusive", "waived"] },
        "confidence": { "$ref": "#/$defs/score" },
        "evidenceRefs": { "$ref": "#/$defs/refArray" },
        "rationale": { "type": "string" },
        "residualRisk": { "type": "string" }
      }
    },
    "governanceEvent": {
      "type": "object",
      "required": ["id", "eventType", "targetRef", "reason", "decision", "approverRefs", "evidenceRefs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "eventType": { "enum": ["introduce-intent", "revise-intent", "deprecate-intent", "retire-intent", "approve-verdict", "challenge-verdict"] },
        "targetRef": { "$ref": "#/$defs/id" },
        "reason": { "type": "string" },
        "decision": { "type": "string" },
        "approverRefs": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "evidenceRefs": { "$ref": "#/$defs/refArray" }
      }
    },
    "acceptanceGate": {
      "type": "object",
      "required": ["id", "name", "requiredArtifactRefs", "criteria"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "requiredArtifactRefs": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["statement", "status"],
            "additionalProperties": false,
            "properties": {
              "statement": { "type": "string" },
              "status": { "enum": ["pass", "fail", "pending"] }
            }
          }
        }
      }
    }
  }
}

