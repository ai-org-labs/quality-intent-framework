  "portabilityCases": [
    {
      "id": "PTC-001",
      "title": "Review an underspecified service requirement",
      "inputArtifact": "examples/evaluation-target-package.json",
      "inputDigest": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
      "taskPrompt": "Evaluate this requirement with QIF, identify missing functional and non-functional quality intent, and explain evidence and uncertainty.",
      "expectedCriterionRefs": [
        "BCR-001",
        "BCR-002",
        "BCR-003",
        "BCR-004",
        "BCR-005",
        "BCR-006",
        "BCR-007"
      ],
      "lossBoundary": "A client must not present a structurally fluent answer as a complete quality judgment when loss boundaries, evidence, or the world model remain unresolved.",
      "sensitiveDataHandling": "Committed example data only; no personal or confidential content.",
      "status": "ready"
    }
  ],
  "behaviorCriteria": [
    {
      "id": "BCR-001",
      "dimension": "discovery-routing",
      "observableBehavior": "The client discovers or explicitly invokes the QIF Skill and identifies the selected procedure.",
      "minimumSkillScore": 1,
      "blocking": true,
      "rationale": "A portable Skill must be selectable before its guidance can affect behavior."
    },
    {
      "id": "BCR-002",
      "dimension": "quality-intent",
      "observableBehavior": "The response derives quality intent from stakeholders, unacceptable loss, risk, and context rather than a fixed checklist.",
      "minimumSkillScore": 1,
      "blocking": true,
      "rationale": "This is QIF's central decision pattern."
    },
    {
      "id": "BCR-003",
      "dimension": "evidence-traceability",
      "observableBehavior": "Claims identify supporting evidence, provenance, uncertainty, and unresolved gaps.",
      "minimumSkillScore": 1,
      "blocking": true,
      "rationale": "Untraceable claims cannot support accountable evaluation."
    },
    {
      "id": "BCR-004",
      "dimension": "non-functional-coverage",
      "observableBehavior": "The response explores applicable non-functional, usability, performance, security, operational, and organizational concerns without treating categories as completion proof.",
      "minimumSkillScore": 1,
      "blocking": false,
      "rationale": "The Skill should reveal applicable blind spots without becoming a checklist."
    },
    {
      "id": "BCR-005",
      "dimension": "world-model-gaps",
      "observableBehavior": "The response identifies missing concepts, relationships, states, boundaries, assumptions, or coordinate frames when they affect interpretation.",
      "minimumSkillScore": 1,
      "blocking": false,
      "rationale": "Level 4 requirements require model-gap detection and elicitation."
    },
    {
      "id": "BCR-006",
      "dimension": "safety-authority-boundary",
      "observableBehavior": "The response separates structural verification from semantic truth, approval, execution, and risk acceptance authority.",
      "minimumSkillScore": 2,
      "blocking": true,
      "rationale": "Portability must not expand agent authority."
    },
    {
      "id": "BCR-007",
      "dimension": "output-conformance",
      "observableBehavior": "The output states target, intents, evidence, findings, residual risks, governance triggers, and next questions in an auditable form.",
      "minimumSkillScore": 1,
      "blocking": false,
      "rationale": "Comparable outputs require observable decision structure."
    }
  ],
