{
  "packageType": "authoring-template",
  "runtimeVersion": "0.6.1",
  "packageId": "ATP-PKG-001",
  "instructionBlocks": [
    {
      "id": "INS-ATP-001",
      "purpose": "Author a minimal quality-gate package from a plain-language request.",
      "instructionText": "Create a QIF quality-gate package that links each quality claim to intent, loss boundary, evidence, verdict, confidence policy, residual risk, and governance trigger when required. Do not treat activity counts or checklist completion as quality.",
      "prohibitedClaims": [
        "semantic truth",
        "checklist completion as quality",
        "test count as quality",
        "hidden chain-of-thought as evidence"
      ],
      "status": "active"
    },
    {
      "id": "INS-ATP-002",
      "purpose": "Keep output executable.",
      "instructionText": "The output must be valid JSON and must pass the referenced local verifier without relying on conversation history.",
      "prohibitedClaims": [
        "manual interpretation required",
        "external system required"
      ],
      "status": "active"
    }
  ],
  "inputContracts": [
    {
      "id": "INC-ATP-001",
      "inputKind": "plain-language quality gate request",
      "description": "A user asks for QIF check items or a QIF evaluation package for a target requirement, repository, operation, or document.",
      "requiredFields": [
        "target",
        "quality concern",
        "stakeholder or harmed party",
        "available evidence"
      ],
      "missingInputPolicy": "ask a concise clarification question or record explicit unresolved ambiguity",
      "status": "active"
    }
  ],
  "outputContracts": [
    {
      "id": "OUC-ATP-001",
      "targetPackageType": "quality-gate",
      "schemaRef": "schemas/quality-gate-package.schema.json",
      "exampleRef": "examples/quality-gate-package.json",
      "requiredEntityFamilies": [
        "evaluationTargets",
        "qualityIntents",
        "evidenceItems",
        "qualityGateRules",
        "qualityGateDecisions",
        "governanceTriggers"
      ],
      "status": "active"
    }
  ],
  "validationPipelines": [
    {
      "id": "VPL-ATP-001",
      "outputContractRef": "OUC-NOPE-999",
      "validationCommand": "node tools/validate-qif-runtime.mjs <generated-package>",
      "successCondition": "validator exits with ok true and no errors",
      "negativeFixtureRefs": [
        "tests/fixtures/quality-gate/"
      ],
      "status": "active"
    }
  ],
  "goldenCases": [
    {
      "id": "GCS-ATP-001",
